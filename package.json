{
  "name": "dsh-plugin-agnes-image",
  "version": "0.1.0",
  "description": "DSH desktop plugin: text-to-image and image-to-image tools for the agent, backed by the Agnes Image 2.5 Flash API.",
  "type": "module",
  "license": "MIT",
  "author": "Neil Ji",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agnes",
    "image-generation",
    "text2img",
    "img2img"
  ],
  "homepage": "https://github.com/neil-ji/dsh-plugin-agnes-image#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neil-ji/dsh-plugin-agnes-image.git"
  },
  "bugs": {
    "url": "https://github.com/neil-ji/dsh-plugin-agnes-image/issues"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/agnes-api.test.mjs test/agnes-tools.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
