{
  "name": "dsh-plugin-agnes-image",
  "version": "0.2.3",
  "description": "DSH desktop plugin: text-to-image and image-to-image tools for the agent, backed by the Agnes Image 2.5 Flash API, with a Settings page that stores the key in the DSH credential store.",
  "type": "module",
  "license": "MIT",
  "author": "Neil Ji",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agnes",
    "image-generation",
    "text2img",
    "img2img"
  ],
  "homepage": "https://github.com/neil-ji/dsh-plugin-agnes-image#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neil-ji/dsh-plugin-agnes-image.git"
  },
  "bugs": {
    "url": "https://github.com/neil-ji/dsh-plugin-agnes-image/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/agnes-api.test.mjs test/agnes-key.test.mjs test/agnes-tools.test.mjs test/client.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  }
}
